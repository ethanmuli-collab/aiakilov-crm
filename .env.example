# AIAKILOV CRM - environment variables
# Copy to .env and fill in. NEVER commit .env

FLASK_SECRET_KEY=change-me-in-production

# Demo mode: local SQLite + demo users, no Supabase required
AIAKILOV_DEMO_MODE=true

# Supabase (optional). When set and AIAKILOV_DEMO_MODE=false the app uses Supabase Auth.
# This is the project's own dedicated Supabase instance (aiakilov-crm,
# eu-central-1), already provisioned with the schema + seed data. The anon
# key below is a publishable client-side key - safe to commit; RLS enforces
# access, not key secrecy.
SUPABASE_URL=https://hgkgzrkhlnuqtfoyfeug.supabase.co
SUPABASE_ANON_KEY=sb_publishable_-3D1iIPp9L8kXA9EQxsauw_b0bXIw0Z
# Server-side only. Get this from the Supabase dashboard yourself if needed.
# Never expose to the browser, never commit a real value here.
SUPABASE_SERVICE_ROLE_KEY=
